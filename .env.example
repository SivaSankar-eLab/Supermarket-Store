# ─────────────────────────────────────────────
#  KiranaBot — Environment Configuration
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Anthropic
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Telegram
TELEGRAM_BOT_TOKEN=1234567890:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_32chars
WEBHOOK_URL=https://your-domain.com/telegram/webhook

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://kirana:kirana_pass@localhost:5432/kiranadb
DATABASE_URL_SYNC=postgresql://kirana:kirana_pass@localhost:5432/kiranadb

# App settings
SHOP_ID=00000000-0000-0000-0000-000000000001
SHOP_NAME=Metro Supermarket
SHOP_OWNER_NAME=Store Manager
SHOP_GSTIN=27AABCU9603R1ZX
SHOP_ADDRESS=123 Main Street, City - 400001

# Claude model
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (optional — required if ai_provider preference is set to "gemini")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Provider fallback: if Gemini fails, retry on Claude (true/false)
# Safe: fallback fires ONLY on exceptions, never on successful tool-use
AI_FALLBACK_ENABLED=true

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# Document storage
DOCS_OUTPUT_DIR=/tmp/kirana_docs
